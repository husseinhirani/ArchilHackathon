# Copy to .env. Every key is optional: missing keys fall back to local implementations.

# --- Anthropic (hider + finder). Missing -> scripted finder + ladder hider.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
FINDER_MODEL=claude-sonnet-5-5
HIDER_MODEL=claude-opus-5-5
FINDER_EFFORT=medium          # low | medium | high
FINDER_BUDGET_S=90
FINDER_MAX_TURNS=16

# --- Archil (sandboxes + shared FS). Missing -> STEGOARENA_PROVIDER=local.
ARCHIL_API_KEY=REPLACE_ME
ARCHIL_REGION=aws-us-west-2   # aws-us-east-1 | aws-us-west-2 | aws-eu-west-1 | gcp-us-central1
ARCHIL_DISK_ID=dsk-REPLACE_ME # shared FS mirror (create with: archil.create_disk(name="stegoarena"))
ARCHIL_BASE_IMAGE=python:3.11-bookworm

# --- Keenable (web research). Keyless works (1k req/h); a key (keen_...) lifts the cap.
KEENABLE_API_KEY=
KEENABLE_ENABLED=1            # 0 -> offline stub

# --- Arena
STEGOARENA_PROVIDER=local     # local | docker | archil
ARENA_ROOT=./arena_data
MAX_CONCURRENCY=4             # Archil Free = 5 concurrent sandboxes; keep 1 for the template
